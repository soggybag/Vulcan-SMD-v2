# Large binaries go through Git LFS (install first: brew install git-lfs && git lfs install)
*.afdesign filter=lfs diff=lfs merge=lfs -text
*.afphoto  filter=lfs diff=lfs merge=lfs -text
*.afpub    filter=lfs diff=lfs merge=lfs -text
*.zip      filter=lfs diff=lfs merge=lfs -text

# KiCad files are text; keep LF line endings
*.kicad_pcb text eol=lf
*.kicad_sch text eol=lf
*.kicad_pro text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf
*.kicad_dru text eol=lf
